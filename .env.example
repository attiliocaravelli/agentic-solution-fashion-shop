# Configurazioni GCP di Progetto (Obbligatorie)
GCP_PROJECT_ID="PROJECT_ID"
GCP_LOCATION="us-central1"
GCP_ZONE="us-central1-b"

# Modello LLM Vertex AI
GEMINI_MODEL="gemini-2.5-flash"

# Bucket GCS Dati
GCS_BUCKET_NAME="BUCKET_ID"

# Percorso Cartella Dati Parquet (./data per test in locale, /mnt/data su Cloud Run)
DATA_DIR="./data"